# MongoDB URI (e.g. MongoDB Atlas cloud cluster connection string)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shieldwise?retryWrites=true&w=majority

# App secrets
SECRET_KEY=your-production-secret-key
JWT_SECRET_KEY=your-production-jwt-secret-key

# Flask
FLASK_ENV=production
FLASK_DEBUG=False
